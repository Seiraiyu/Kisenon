# Connection string for your project's main branch (keon connection-string main --project <id>).
DATABASE_URL=

# Only needed for --what-if (forks main with `keon branches create`).
KISENON_PROJECT_ID=

# Optional. Without it, replies list recalled facts and user messages are stored verbatim as facts.
ANTHROPIC_API_KEY=

# Optional. Only for --embedder voyage.
VOYAGE_API_KEY=
