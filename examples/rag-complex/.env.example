# Connection string for your Kisenon main branch:
#   keon connection-string main --project <project-id>
DATABASE_URL=

# Your Kisenon project id (used by `experiment` to fork main).
KISENON_PROJECT_ID=

# Local Meilisearch (docker compose up -d). Pick any 16+ character key:
#   openssl rand -hex 16
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# Optional. Enables the rerank-2 step and --embedder voyage.
VOYAGE_API_KEY=
# Optional. Enables `ask` answers (otherwise hits are printed).
ANTHROPIC_API_KEY=
# Optional. Only needed for --embedder openai.
OPENAI_API_KEY=
