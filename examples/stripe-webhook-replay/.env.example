# Kisenon: project id (for keon) and main's connection string.
KISENON_PROJECT_ID=
KISENON_URL=

# Live mode only (Stripe CLI + `npm run server`). Offline fixture mode needs neither.
# Test-mode secret key from the Stripe dashboard (Developers -> API keys, test mode).
STRIPE_SECRET_KEY=
# Signing secret printed by `stripe listen --print-secret`.
STRIPE_WEBHOOK_SECRET=
PORT=4242
