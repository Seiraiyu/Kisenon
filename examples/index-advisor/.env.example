# Your Kisenon project id (used for `keon` calls).
KISENON_PROJECT_ID=

# Your project's main-branch connection string. index-advisor READS pg_stat_statements
# and table stats from main; it never writes there.
KISENON_URL=

# LLM key. The CLI reads whichever matches --provider (default anthropic).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
