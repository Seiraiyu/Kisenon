# Project-scoped, agent-capability Kisenon API key (see README). Optional if you
# ran `keon login` and prefer that session's credentials.
KEON_API_KEY=

# Project whose main branch gets forked. Optional if set via `keon set-context`.
KISENON_PROJECT_ID=

# Minutes before a fork is destroyed automatically (default 30).
KISENON_FORK_TTL_MIN=30
